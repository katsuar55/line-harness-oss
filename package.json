{
  "name": "line-oss-crm",
  "version": "0.8.0",
  "private": true,
  "description": "Open-source LINE Official Account CRM/marketing automation",
  "scripts": {
    "dev:worker": "pnpm --filter worker run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm -r build",
    "deploy:worker": "pnpm --filter worker run deploy",
    "deploy:web": "pnpm --filter web run build",
    "db:migrate": "wrangler d1 execute line-crm --file=packages/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute line-crm --file=packages/db/schema.sql --local",
    "deploy:setup": "node packages/create-line-harness/dist/index.js",
    "deploy:update": "node packages/create-line-harness/dist/index.js update",
    "preflight": "node scripts/preflight.mjs",
    "preflight:full": "node scripts/preflight.mjs --full",
    "preflight:test": "node --test scripts/preflight.test.mjs",
    "post-deploy-check": "node scripts/post-deploy-check.mjs",
    "post-deploy-check:test": "node --test scripts/post-deploy-check.test.mjs",
    "liff-health": "node scripts/liff-health-check.mjs",
    "liff-health:test": "node --test scripts/liff-health-check.test.mjs",
    "cutover-prep-A": "node scripts/cutover-prep-A.mjs",
    "cutover-prep-A:test": "node --test scripts/cutover-prep-A.test.mjs",
    "test:scripts": "node --test scripts/preflight.test.mjs scripts/post-deploy-check.test.mjs scripts/cutover-prep-A.test.mjs scripts/liff-health-check.test.mjs"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.112.0"
  }
}
